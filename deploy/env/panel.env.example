# /etc/panel/panel.env —— 两个颜色共用的生产配置（chmod 600, owner root）
# 取值说明与必改项见 docs/部署与升级-运行手册.md §2.2
# 注意：本文件会被 bash `source`，值里有空格请加引号。

# ---------- 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=panel_ai
MYSQL_USER=panel
MYSQL_PASSWORD=CHANGE_ME

# ---------- Redis（会话 / 限流 / 任务队列） ----------
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME

# ---------- 检索与存储：单机方案 A ----------
PANEL_SEARCH_KEYWORD_BACKEND=memory
PANEL_SEARCH_VECTOR_BACKEND=memory
PANEL_SEARCH_RECOVER_INDEX_ON_START=true
PANEL_OBJECT_STORE=local
PANEL_OBJECT_STORE_LOCAL_DIR=/opt/panel/data/knowledge
PANEL_JOB_QUEUE=redis

# ---------- 安全 ----------
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
PANEL_ENV=prod
# Nginx 反代后必须打开，否则限流看到的 IP 全是 127.0.0.1
SERVER_FORWARD_HEADERS_STRATEGY=framework
# 优雅停机：发布时让在途请求收尾
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# ---------- 注册闸门 ----------
PANEL_SIGNUP_MODE=invite
PANEL_SIGNUP_INVITE_CODE=CHANGE_ME_12_CHARS
PANEL_TURNSTILE_ENABLED=false
PANEL_TURNSTILE_SITE_KEY=
PANEL_TURNSTILE_SECRET=

# ---------- 邮件（QQ 邮箱示例；password 填授权码） ----------
PANEL_MAIL_HOST=smtp.qq.com
PANEL_MAIL_PORT=465
PANEL_MAIL_USERNAME=
PANEL_MAIL_PASSWORD=
PANEL_MAIL_FROM="Panel <noreply@example.com>"

# ---------- 模型 ----------
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_CHAT_MODEL=qwen3.8-flash

# ---------- 可选：首次启动的管理员引导，登录后立刻删除这两行 ----------
# PLATFORM_ADMIN_EMAIL=admin@panel.local
# PLATFORM_ADMIN_USERNAME=admin
# PLATFORM_ADMIN_PASSWORD=CHANGE_ME
