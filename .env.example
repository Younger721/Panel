# Panel 本地全栈配置（复制为 .env 后修改 MYSQL_PASSWORD 与 DASHSCOPE_API_KEY）
# 启动：start-infrastructure.bat → start-backend-dev.bat
# 说明：本文件只放本地开发值，生产环境请用真实密钥管理

COMPOSE_PROJECT_NAME=panel-ai

# ---------- 必填 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=panel_ai
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
DASHSCOPE_API_KEY=

# 对象存储桶名：固定值，不要跟着产品改名走（改名会让历史文件的 key 全部失联）
PANEL_OBJECT_STORE_MINIO_BUCKET=panel-ai

# ---------- 中间件端口（指向本机已运行的共享实例，一般不用改） ----------
USE_DOCKER_MYSQL=0
MYSQL_HOST_PORT=3307
REDIS_HOST=localhost
REDIS_HOST_PORT=6379
ES_HOST_PORT=9202
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_HOST_PORT=9092
PANEL_KAFKA_BOOTSTRAP=localhost:9092

# ---------- 后端（默认值已在 application-dev.yml，仅在需要时取消注释） ----------
# SPRING_PROFILES_ACTIVE=dev
# JWT_SECRET=Panel-local-dev-secret-change-me-please-32bytes
# PLATFORM_ADMIN_PASSWORD=123456
# PANEL_KNOWLEDGE_INGEST_TWO_PHASE=false
# PANEL_KNOWLEDGE_INGEST_MAX_ATTEMPTS=5

# ---------- 可选：联网搜索（面试场景默认关闭） ----------
# AI_WEB_SEARCH_PROVIDER=tavily
# AI_WEB_SEARCH_API_KEY=
